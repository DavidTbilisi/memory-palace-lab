{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "mcp-bridge:default",
    "fs:allow-appdata-write-recursive",
    "opener:default",
    "fs:default",
    "dialog:default",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPDATA/palace-backgrounds"
        },
        {
          "path": "$APPDATA/palace-backgrounds/**"
        }
      ]
    }
  ]
}
