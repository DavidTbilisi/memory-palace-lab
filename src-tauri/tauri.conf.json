{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Memory Palace Lab",
  "version": "0.8.0",
  "identifier": "com.memorypalace.lab",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Memory Palace Lab",
        "width": 800,
        "height": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data: https: http:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.anthropic.com",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data: https: http:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420 https://api.anthropic.com",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/palace-backgrounds",
          "$APPDATA/palace-backgrounds/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzQzg3REVBQ0NGMUMzNDIKUldSQ3cvSE02bjNJazFDZFdBeHFQRGhqbG16ODNUcE1jVmI3anUyczNYQ1VpVmt2dW1Ic1hIZ3MK",
      "endpoints": [
        "https://github.com/DavidTbilisi/memory-palace-lab/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
