{
  "scopeName": "source.palace-dsl",
  "name": "Palace DSL",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#header"
    },
    {
      "include": "#atlas"
    },
    {
      "include": "#route"
    },
    {
      "include": "#node"
    },
    {
      "include": "#portal"
    },
    {
      "include": "#edge"
    },
    {
      "include": "#tags"
    },
    {
      "include": "#content"
    },
    {
      "include": "#locus"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "^\\s*(--).*$",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.palace-dsl"
            }
          },
          "name": "comment.line.double-dash.palace-dsl"
        }
      ]
    },
    "header": {
      "patterns": [
        {
          "match": "^(#\\s*Palace:|@Palace)(\\s+.*)?$",
          "captures": {
            "1": {
              "name": "keyword.control.header.palace-dsl"
            },
            "2": {
              "name": "entity.name.section.palace-dsl"
            }
          }
        }
      ]
    },
    "atlas": {
      "patterns": [
        {
          "match": "^(@atlas)(\\s+\\S.*)?$",
          "captures": {
            "1": {
              "name": "keyword.control.atlas.palace-dsl"
            },
            "2": {
              "name": "string.unquoted.path.palace-dsl"
            }
          }
        }
      ]
    },
    "route": {
      "patterns": [
        {
          "match": "^((?:\\/Route|::\\s*Route)\\s+)(\"[^\"]*\")\\s*$",
          "captures": {
            "1": {
              "name": "keyword.control.route.palace-dsl"
            },
            "2": {
              "name": "string.quoted.double.palace-dsl"
            }
          }
        }
      ]
    },
    "node": {
      "patterns": [
        {
          "match": "^(?!\\s)(?!#\\s*Palace:)(?!@Palace\\b)(?!@atlas\\b)(?!(?:\\/Route|::\\s*Route)\\b)([^#@>:\\-].*)$",
          "captures": {
            "1": {
              "name": "entity.name.type.palace-dsl"
            }
          }
        }
      ]
    },
    "portal": {
      "patterns": [
        {
          "match": "^(\\s*(?:~portal|@portal))(\\s+\\S.*)?$",
          "captures": {
            "1": {
              "name": "keyword.control.portal.palace-dsl"
            },
            "2": {
              "name": "string.unquoted.path.palace-dsl"
            }
          }
        }
      ]
    },
    "edge": {
      "patterns": [
        {
          "match": "^(\\s*(?:>|->))(.*?)(\\s+::)(\\S.*)?$",
          "captures": {
            "1": {
              "name": "keyword.operator.edge.palace-dsl"
            },
            "2": {
              "name": "entity.name.reference.palace-dsl"
            },
            "3": {
              "name": "keyword.operator.cast.palace-dsl"
            },
            "4": {
              "name": "constant.numeric.cast.palace-dsl"
            }
          }
        }
      ]
    },
    "tags": {
      "patterns": [
        {
          "match": "(#[A-Za-z0-9_-]+)",
          "name": "storage.modifier.tag.palace-dsl"
        }
      ]
    },
    "content": {
      "patterns": [
        {
          "match": "^(\\s*:)(.*)$",
          "captures": {
            "1": {
              "name": "keyword.operator.content.palace-dsl"
            },
            "2": {
              "name": "string.unquoted.content.palace-dsl"
            }
          }
        }
      ]
    },
    "locus": {
      "patterns": [
        {
          "match": "^(\\s*\\d+\\.)(\\s+.*)$",
          "captures": {
            "1": {
              "name": "constant.numeric.index.palace-dsl"
            },
            "2": {
              "name": "entity.name.reference.palace-dsl"
            }
          }
        }
      ]
    }
  }
}
