{
  "scopeName": "source.palace-dsl",
  "name": "Palace DSL",
  "patterns": [
    { "include": "#comments" },
    { "include": "#atlas" },
    { "include": "#portal" },
    { "include": "#header" },
    { "include": "#body" },
    { "include": "#tags" },
    { "include": "#edge" },
    { "include": "#route" },
    { "include": "#locus" },
    { "include": "#node" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "^\\s*(--)(.*)",
          "captures": {
            "1": { "name": "punctuation.definition.comment.palace-dsl" },
            "2": { "name": "comment.line.double-dash.palace-dsl" }
          },
          "name": "comment.line.double-dash.palace-dsl"
        }
      ]
    },
    "atlas": {
      "patterns": [
        {
          "match": "^(@atlas)(\\s+\\S.*)?$",
          "captures": {
            "1": { "name": "keyword.control.atlas.palace-dsl" },
            "2": { "name": "string.unquoted.path.palace-dsl" }
          }
        }
      ]
    },
    "portal": {
      "patterns": [
        {
          "match": "^\\s*(@portal)(\\s+\\S.*)?$",
          "captures": {
            "1": { "name": "keyword.control.portal.palace-dsl" },
            "2": { "name": "string.unquoted.path.palace-dsl" }
          }
        }
      ]
    },
    "header": {
      "patterns": [
        {
          "match": "^(@)(\\S.*)?$",
          "captures": {
            "1": { "name": "keyword.control.header.palace-dsl" },
            "2": { "name": "entity.name.section.palace-dsl" }
          }
        }
      ]
    },
    "body": {
      "patterns": [
        {
          "match": "^\\s*(:)(.*)",
          "captures": {
            "1": { "name": "keyword.operator.content.palace-dsl" },
            "2": { "name": "string.unquoted.content.palace-dsl" }
          }
        }
      ]
    },
    "tags": {
      "patterns": [
        {
          "match": "(#[A-Za-z0-9_-]+)",
          "name": "storage.modifier.tag.palace-dsl"
        }
      ]
    },
    "edge": {
      "patterns": [
        {
          "match": "^\\s*(>)(.*?)(\\s+[0-9]{4})$",
          "captures": {
            "1": { "name": "keyword.operator.edge.palace-dsl" },
            "2": { "name": "entity.name.reference.palace-dsl" },
            "3": { "name": "constant.numeric.cast.palace-dsl" }
          }
        },
        {
          "match": "^\\s*(>)(.*)",
          "captures": {
            "1": { "name": "keyword.operator.edge.palace-dsl" },
            "2": { "name": "entity.name.reference.palace-dsl" }
          }
        }
      ]
    },
    "route": {
      "patterns": [
        {
          "match": "^(/)(.*)$",
          "captures": {
            "1": { "name": "keyword.control.route.palace-dsl" },
            "2": { "name": "string.unquoted.route-name.palace-dsl" }
          }
        }
      ]
    },
    "locus": {
      "patterns": [
        {
          "match": "^\\s*(\\d+)(\\s+.*)$",
          "captures": {
            "1": { "name": "constant.numeric.index.palace-dsl" },
            "2": { "name": "entity.name.reference.palace-dsl" }
          }
        }
      ]
    },
    "node": {
      "patterns": [
        {
          "match": "^(?!\\s*(?:--|@|:|#|>|/|\\d+\\s))(.+)$",
          "captures": {
            "1": { "name": "entity.name.type.palace-dsl" }
          }
        }
      ]
    }
  }
}
