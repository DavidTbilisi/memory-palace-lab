{
  "name": "palace-dsl-vscode",
  "displayName": "Palace DSL Tools",
  "description": "Syntax highlighting and parser-backed diagnostics for Memory Palace DSL files.",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "activationEvents": [
    "onLanguage:palace-dsl"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "npx esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node18 --external:vscode --outfile=dist/extension.js",
    "package": "npm run build && vsce package --no-dependencies",
    "watch": "npx esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node18 --external:vscode --outfile=dist/extension.js --watch"
  },
  "contributes": {
    "languages": [
      {
        "id": "palace-dsl",
        "aliases": [
          "Palace DSL",
          "palace-dsl"
        ],
        "extensions": [
          ".dsl"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "palace-dsl",
        "scopeName": "source.palace-dsl",
        "path": "./syntaxes/palace-dsl.tmGrammar.json"
      }
    ]
  }
}
